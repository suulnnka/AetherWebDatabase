{
  "name": "aether-webdatabase",
  "version": "0.1.0",
  "type": "module",
  "description": "Web 文件型文档数据库:整库 JSON 落盘、可选 AES-GCM 加密、每库单线程串行、单条指令原子的集合 CRUD,零依赖",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./crypto": "./src/crypto.js",
    "./storage": "./src/storage.js",
    "./database": "./src/database.js"
  },
  "scripts": {
    "test": "node test/db-test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/suulnnka/AetherWebDatabase.git"
  },
  "keywords": [
    "database",
    "document-store",
    "localStorage",
    "encryption",
    "aes-gcm",
    "webos",
    "嵌入式",
    "文档库"
  ],
  "sideEffects": false,
  "private": false
}
